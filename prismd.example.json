      "504"
    ],
    "maxCandidatesPerRequest": 2,
    "quotaSoftLimitRatio": 0.8,
    "respectRetryAfter": true,
    "retryAfterStream": false,
    "retryBeforeStream": true,
    "streamIdleTimeoutMs": 300000
