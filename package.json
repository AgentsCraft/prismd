{
  "name": "@prismd/prismd",
  "version": "0.0.0",
  "description": "Local-first LLM gateway aggregating free/low-quota model APIs for coding agents",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentsCraft/prismd.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "presets",
    "examples",
    "config.schema.json",
    "scripts",
    "config.user.example.json",
    "prismd.example.json",
    ".env.example"
  ],
  "bin": {
    "prismd": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "generate:config": "node scripts/generate-config.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "ajv": "^8.17.1",
    "hono": "^4.6.14",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
