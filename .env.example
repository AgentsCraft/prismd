# ~/.prismd/.env (dotenv format) — alternative to keys.yaml.
# Copy to ~/.prismd/.env and chmod 600. Never commit real keys.
#
# Lookup priority (highest wins):
#   1. OS environment variable  <FIELD>_API_KEY  (e.g. OPENROUTER_API_KEY)
#   2. this file                KEY=VALUE lines
#   3. ~/.prismd/keys.yaml      field: value

# Local gateway auth token; generate with: openssl rand -hex 32
PRISMD_API_KEY=

# Upstream API keys (fill in keys for the providers you use):
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GITHUB_API_KEY=
