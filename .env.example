# Local gateway auth token; the Codex prismd profile reads it via env_key = "PRISMD_API_KEY".
# Generate with: openssl rand -hex 32
PRISMD_API_KEY=

# Upstream API keys, referenced by apiKeyEnv in presets/providers.json.
# Candidates for providers without a key here are skipped by generate:config.
OPENROUTER_API_KEY=
GROQ_API_KEY=
